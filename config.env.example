# AWS_REGION が空の場合は AWS CLI のデフォルトリージョンを利用します。
AWS_REGION=

# 切替先ライセンスの AMI ID（例: ami-xxxxxxxxxxxxxxxxx）
NEW_AMI_ID=

# create-image 時に再起動しない場合は true。
# デフォルト false は整合性優先で AWS による再起動を許可します。
BACKUP_NO_REBOOT=false

# uefi-preferred AMI を legacy-bios の旧インスタンスへ使用する危険を明示的に許可する場合のみ true。
ALLOW_UEFI_PREFERRED_ON_BIOS=false

# インスタンスストアが失われる構成を明示的に許可する場合のみ true。
ALLOW_INSTANCE_STORE_LOSS=false

# true にすると旧 EC2 の UserData を新 EC2 へ引き継ぎます。
# 切替後の初回起動で旧 OS の cloud-init が新インスタンス ID を検知し、引き継いだ UserData の
# スクリプトを再実行するため、冪等性を確認済みの場合のみ有効化してください。
COPY_USER_DATA=false

# 新 EC2 に期待する UsageOperation（例: RunInstances:00g0）。
# 空の場合は旧値から変化し、新値が空でないことだけを検証します。
EXPECTED_NEW_USAGE_OPERATION=""

# 状態ファイル保存先
WORK_DIR=./work

# 待機タイムアウト（秒）
WAIT_IMAGE_AVAILABLE_TIMEOUT=3600
WAIT_INSTANCE_STATE_TIMEOUT=1800
WAIT_VOLUME_STATE_TIMEOUT=1800
WAIT_ENI_AVAILABLE_TIMEOUT=900
WAIT_STATUS_OK_TIMEOUT=1800
